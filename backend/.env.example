# החלף בכתובת החיבור שתקבל מ-Neon (Dashboard -> Connection string).
# חשוב: תבחר את ה-"pooled connection string" (מכיל "-pooler" בשם ה-host),
# מתאים יותר לאפליקציית שרת מאשר לחיבור ישיר.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dull?sslmode=require"

# אותו Neon project, אבל ה-"Direct connection string" (בלי "-pooler" בשם
# ה-host) - נדרש ע"י prisma/schema.prisma (datasource.directUrl). זה חייב
# להיות שונה מ-DATABASE_URL, לא אותו ערך: Prisma CLI (migrate/studio) צריך
# חיבור ישיר כדי לנעול advisory lock ברמת session בזמן מיגרציה - נעילה כזו
# לא עובדת דרך ה-pooled connection (PgBouncer transaction pooling מחליף
# connections פיזיים בין statements ולא שומר session יציב), ותקבל טיימאאוט
# P1002 אם תשים כאן בטעות את אותה כתובת pooled. האפליקציה עצמה ב-runtime
# ממשיכה להשתמש רק ב-DATABASE_URL - DIRECT_URL משמש רק את ה-CLI.
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/dull?sslmode=require"

PORT=4000

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID.
# לא סוד (גם ה-frontend חושף אותו) - אבל עדיין ערך אמיתי, לא לדבוק כאן.
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# סוד אמיתי - ליצור בעצמך עם `openssl rand -hex 32` ולהדביק רק ב-.env
# (הקובץ הזה, .env.example, נשאר תמיד ב-git עם ערכי placeholder בלבד).
JWT_SECRET="replace-with-output-of-openssl-rand-hex-32"

# resend.com/api-keys - סוד אמיתי, ליצור אחרי הרשמה חינמית ל-Resend.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# לפני אימות דומיין משלך מול Resend, חובה להשתמש בדיוק בכתובת ה-sandbox
# הזו - שליחה מכל כתובת אחרת תיכשל עד שיאומת דומיין.
EMAIL_FROM="Dull <onboarding@resend.dev>"
