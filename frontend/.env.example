# כתובת ה-API החיה - ראו docs/API_CONTRACT.md. ב-dev מקומי מול backend
# שרץ על המחשב: http://localhost:4000. בפרודקשן: https://dull.onrender.com
VITE_API_BASE_URL="http://localhost:4000"

# Google OAuth Client ID - אותו client שיש ל-backend (GOOGLE_CLIENT_ID ב-
# backend/.env). לא סוד (נחשף גם בקוד ה-frontend), אבל עדיין ערך אמיתי -
# לא לדבוק כאן. נדרש רק ממסך ה-checkout (התחברות), לא בעמוד הפריט.
VITE_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
