# כתובת ה-API החיה - ראו docs/API_CONTRACT.md. ב-dev מקומי מול backend
# שרץ על המחשב: http://localhost:4000. בפרודקשן: https://dull.onrender.com
VITE_API_BASE_URL="http://localhost:4000"

# Google OAuth Client ID - אותו client שיש ל-backend (GOOGLE_CLIENT_ID ב-
# backend/.env). לא סוד (נחשף גם בקוד ה-frontend), אבל עדיין ערך אמיתי -
# לא לדבוק כאן. נדרש רק ממסך ה-checkout (התחברות), לא בעמוד הפריט.
VITE_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# Mixpanel Project Token (docs/PRD.md סעיף 20, בקשת Oren 2026-09-12) - לא
# סוד (טוקן פרויקט Mixpanel, לא API secret - מיועד מלכתחילה לחשיפה בקוד
# צד-לקוח). *אופציונלי בכוונה* (src/config/env.ts) - אם לא מוגדר, האנליטיקה
# פשוט כבויה בשקט (src/lib/analytics.ts) ושאר האתר ממשיך לעבוד רגיל. לא
# מוגדר עדיין ב-.env המקומי בפועל - טרם נפתח חשבון Mixpanel.
VITE_MIXPANEL_TOKEN=""
